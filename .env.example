# ==============================================================
# Excaliflow - Contoh Konfigurasi Environment
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
#
# Catatan:
# - Variabel environment asli (dari shell/OS) selalu menang.
# - Komentar harus di baris sendiri, jangan di belakang nilai.
# ==============================================================

# -------------------- Koneksi MySQL --------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345678
DB_NAME=excaliflow

# -------------------- Server HTTP --------------------
PORT=3000
# Folder berisi index.html, css, dan dist (default: folder proyek).
# Tidak dipakai bila frontend di-host terpisah (mis. Cloudflare Pages).
STATIC_DIR=.

# -------------------- Keamanan --------------------
# WAJIB diganti dengan string acak yang panjang saat production.
JWT_SECRET=excaliflow-secret-key-change-in-production

# -------------------- CORS --------------------
# "*" untuk semua origin, atau daftar origin dipisah koma tanpa
# path / trailing slash. Contoh production (frontend di Cloudflare Pages):
# CORS_ORIGINS=https://excaliflow.pages.dev
CORS_ORIGINS=*

# -------------------- Opsional --------------------
# Lokasi file .env lain bila tidak ingin memakai .env di folder proyek.
# ENV_FILE=.env
